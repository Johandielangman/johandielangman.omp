{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "os": "#ACB0BE",
    "pink": "#F5BDE6",
    "lavender": "#B7BDF8",
    "blue": "#8AADF4",
    "red": "#ED8796",
    "wight": "#FFFFFF",
    "text": "#494D64",
    "spotify": "#A6E3A1"
  },
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "background": "p:blue",
          "foreground": "p:wight",
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "🐓",
          "type": "text"
        },
        {
          "background": "p:blue",
          "foreground": "p:text",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": "{{ if .Segments.Contains \"Git\" }}{{ .Segments.Git.User.Email }}{{ else }}{{ .UserName }}{{ end }}",
          "type": "session"
        },
        {
          "background": "p:pink",
          "foreground": "p:text",
          "options": {
            "folder_icon": "\ue5fe ",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " {{ .Path }}",
          "type": "path"
        },
        {
          "background": "p:blue",
          "foreground": "p:text",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }} \uf192{{ end }} \uec39 {{ .Full }}{{ end }}",
          "type": "python"
        },
        {
          "type": "spotify",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "foreground": "p:text",
          "background": "p:spotify",
          "template": " {{ .Icon }}{{ if ne .Status \"stopped\" }}{{ if gt (len .Artist) 20 }}{{ trunc 20 .Artist }}...{{ else }}{{ .Artist }}{{ end }} - {{ if gt (len .Track) 20 }}{{ trunc 20 .Track }}...{{ else }}{{ .Track }}{{ end }}{{ end }}",
          "options": {
            "playing_icon": "\ue602 ",
            "paused_icon": "\uf04c ",
            "stopped_icon": "\uf04d ",
            "ad_icon": "\ueebb "
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "p:lavender",
          "foreground": "p:text",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "type": "git",
          "options": {
            "branch_template": "{{ if gt (len .Branch) 15 }}{{ trunc 20 .Branch }}...{{ else }}{{ .Branch }}{{ end }}"
          },
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:pink{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:lavender{{ end }}",
            "{{ if gt .Behind 0 }}p:blue{{ end }}"
          ],
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:blue",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ else }}p:blue{{ end }}"
          ],
          "template": "\uf0a4 ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "p:blue",
    "template": "❯ "
  },
  "final_space": true,
  "version": 4
}
